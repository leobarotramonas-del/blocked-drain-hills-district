---
import HomeCall from './HomeCall.astro';
import { site } from '../data/site';
interface Props { title?: string; text?: string; callLabel?: string; }
const { callLabel, title = 'Need a Drain Plumber in the Hills District?', text = 'Tell us what the drain is doing and we’ll help arrange the right response.' } = Astro.props;
---
<section class="cta-band">
  <div class="cta-band__inner">
    <div><h2>{title}</h2><p>{text}</p></div>
    {callLabel ? <HomeCall compact label={callLabel} /> : <a class="call-button" href={site.phoneHref}><span>Call Now</span><strong>{site.phoneDisplay}</strong></a>}
  </div>
</section>
