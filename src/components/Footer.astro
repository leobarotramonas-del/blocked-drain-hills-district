---
import { areas, services, site } from '../data/site';
---
<footer class="site-footer">
  <div class="site-footer__inner">
    <div class="footer-brand">
      <a class="brand brand--text" href="/" aria-label="Antons Blocked Drains Hills District home"><strong>ANTONS</strong><span>BLOCKED DRAINS</span><small>HILLS DISTRICT</small></a>
      <p>A specialist Hills District drain service operated by Antons Enterprises Pty Ltd. NSW contractor licence {site.licence}.</p>
    </div>
    <div><h2>Services</h2>{services.map((item) => <a href={`/services/${item.slug}/`}>{item.name}</a>)}</div>
    <div><h2>Service Areas</h2>{areas.map((area) => <a href={`/service-areas/${area.slug}/`}>{area.name}</a>)}</div>
    <div><h2>Contact</h2><a href={site.phoneHref}>{site.phoneDisplay}</a><a href="/contact/">Contact Us</a><a href="/privacy/">Privacy</a><a href="/terms/">Terms</a></div>
  </div>
</footer>
