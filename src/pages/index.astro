---
import ProjectShowcase from "../components/ProjectShowcase.astro";
import BaseLayout from '../layouts/BaseLayout.astro';
import ResponsiveImage from '../components/ResponsiveImage.astro';
import CtaBand from '../components/CtaBand.astro';
import { areas, faqs, reviews, services, site } from '../data/site';

const schema = {
  '@context': 'https://schema.org', '@type': 'FAQPage',
  mainEntity: faqs.slice(0, 3).map((faq) => ({ '@type': 'Question', name: faq.question, acceptedAnswer: { '@type': 'Answer', text: faq.answer } })),
};


---
<BaseLayout title="24/7 Drain Plumber Hills District | Antons Blocked Drains" description="Blocked drain in the Hills District? Call for professional drain clearing, CCTV inspection, high-pressure water jetting and drain repair advice. Urgent calls answered 24/7." schema={schema}>
  <div class="drain-home">
    <section class="drain-hero" aria-labelledby="hero-title">
      <div class="drain-hero__copy">
        <h1 id="hero-title">Blocked drains cleared with the cause in sight.</h1>
        <p>Antons Blocked Drains Hills District provides drain clearing, CCTV inspections and pipe repairs. We assess the cause, choose equipment for the line and explain the work before it proceeds.</p>
        <div class="drain-hero__actions">
          <a class="call-button" href={site.phoneHref}><span>Call a Drain Plumber</span><strong>{site.phoneDisplay}</strong></a>
          <a class="home-button home-button--light" href="/services/">See Drain Services</a>
        </div>
        <ul class="drain-proof"><li>Urgent calls answered 24/7</li><li>NSW licence {site.licence}</li><li>25+ years’ plumbing experience</li><li>Hills District coverage</li></ul>
      </div>
      <div class="drain-hero__media">
        <ResponsiveImage src="/images/blocked-drains.webp" alt="Drain plumber using high-pressure drain-clearing equipment at an outdoor access point" widths={[360, 480, 672]} quality={52} sizes="(max-width: 760px) calc(100vw - 2rem), 52vw" loading="eager" fetchpriority="high" />
        <div class="drain-hero__note"><strong>Find it. Clear it. Check it.</strong><span>Jetting · CCTV · repair</span></div>
      </div>
    </section>

    <section class="urgent-strip" aria-label="Immediate blocked drain advice">
      <strong>Overflowing now?</strong><p>Stop using connected fixtures. Keep people and pets away from wastewater. Do not add chemicals.</p><a href={site.phoneHref}>Call {site.phoneDisplay}</a>
    </section>

    <section class="drain-section symptom-section" aria-labelledby="symptoms-title">
      <div class="section-heading"><h2 id="symptoms-title">Start with what the drain is doing.</h2><p>You do not need to diagnose the fault. Choose the symptom closest to yours and see how a professional assessment narrows down the cause.</p></div>
      <div class="symptom-list">
        {services.slice(0, 4).map((service) => <a href={`/services/${service.slug}/`}><h3>{service.name}</h3><p>{service.summary}</p><strong>See signs and solutions</strong></a>)}
      </div>
    </section>

    <p>Operated by {site.operator} under NSW contractor licence {site.licence}. <a href="/about/">Meet the team</a>.</p>
    <ProjectShowcase heading="Recent drainage projects in the Hills District and across Sydney" items={["sewer-jetting", "drain-pipework-installation", "restricted-access-excavation"]} id="proof" />

    <section class="local-section" aria-labelledby="areas-title">
      <div class="local-section__heading"><h2 id="areas-title">Blocked drain expertise across the Hills District.</h2><p>Property age, trees, slope, access and shared services all influence the right drainage approach. Each local guide explains the practical considerations for that area.</p><a href="/service-areas/">View all service areas</a></div>
      <div class="local-grid">{areas.map((area) => <a href={`/service-areas/${area.slug}/`}><span>{area.postcode}</span><strong>{area.name}</strong></a>)}</div>
    </section>

    <section class="drain-section reviews-section" id="reviews" aria-labelledby="reviews-title">
      <div class="section-heading"><h2 id="reviews-title">Customers remember the explanation.</h2><p>Genuine feedback from plumbing customers, including people who were shown CCTV drain-camera findings and guided through the repair options.</p></div>
      <div class="review-list">{reviews.map((review) => <figure><blockquote>“{review.text}”</blockquote><figcaption>{review.name}</figcaption></figure>)}</div>
    </section>

    <section class="drain-section faq-section" aria-labelledby="faq-title">
      <div class="section-heading"><h2 id="faq-title">Blocked-drain questions, answered clearly.</h2><p>Useful guidance before you call. If wastewater is overflowing, stop using affected fixtures and contact a professional.</p></div>
      <div class="faq-list">{faqs.slice(0, 3).map((faq) => <details><summary>{faq.question}</summary><p>{faq.answer}</p></details>)}</div>
    </section>
  </div>
  <CtaBand title="Tell Us What Your Drain Is Doing" />
</BaseLayout>
