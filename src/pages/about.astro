---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import CtaBand from '../components/CtaBand.astro';
import ResponsiveImage from '../components/ResponsiveImage.astro';
import FaqSection from '../components/FaqSection.astro';
import { site } from '../data/site';
import { faqSchema, pageFaqs } from '../data/faqs';
---
<BaseLayout title="About Our Hills District Blocked Drain Plumbers" description={`Meet the licensed blocked-drain team behind ${site.name}. Learn how experience, CCTV inspection, water jetting and clear diagnosis shape our Hills District drain service.`} schema={faqSchema(pageFaqs.about)}>
  <PageHero label="About the Team" title="Hills District drain plumbers focused on the cause." intro="More than 25 years of plumbing experience, specialist drainage equipment and a clear distinction between temporary clearing and lasting repair." image="/images/team.webp" imageAlt="Three licensed plumbers standing beside a blue service vehicle" />
  <section class="section detail-grid">
    <div><h2>Licensed Blocked Drain Service in the Hills District</h2><p>{site.name} is provided by {site.operator}. Regulated drainage work is undertaken under NSW contractor licence {site.licence}.</p><p>The dedicated website helps Hills District customers find focused information about blocked toilets, sewer and stormwater drains, CCTV inspections, water jetting and drain repairs.</p></div>
    <div><h2>Professional Drain Diagnosis and Repair</h2><p>We start with symptoms, inspect accessible pipework and choose equipment for the line. High-pressure jetting may clear the obstruction; CCTV and electronic locating can show why it returned; targeted excavation can repair a failed section.</p><p>Explore our <a href="/services/">blocked drain services</a> or <a href="/contact/">call a drain plumber</a> to discuss the next step.</p></div>
  </section>
  <section class="operator-gallery"><ResponsiveImage src="/images/drain-camera-inspection.webp" alt="CCTV drain inspection equipment used to diagnose pipe condition" sizes="(max-width: 760px) calc(100vw - 32px), 46vw" loading="lazy" /><ResponsiveImage src="/images/blocked-drain-excavation.webp" alt="Drain plumber completing underground pipe repair work" sizes="(max-width: 760px) calc(100vw - 32px), 46vw" loading="lazy" /></section>
  <FaqSection title="About Our Drain Service" intro="Answers about experience, licensing, equipment and what customers can expect." items={pageFaqs.about} />
  <CtaBand />
</BaseLayout>
