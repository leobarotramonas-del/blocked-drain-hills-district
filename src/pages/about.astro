---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import CtaBand from '../components/CtaBand.astro';
import ResponsiveImage from '../components/ResponsiveImage.astro';
import FaqSection from '../components/FaqSection.astro';
import { site } from '../data/site';
import { faqSchema, pageFaqs } from '../data/faqs';
---
<BaseLayout title="About Antons Blocked Drains Hills District" description="Meet the licensed team behind Antons Blocked Drains Hills District and learn how experience, specialist equipment and clear diagnosis shape our drain service." schema={faqSchema(pageFaqs.about)}>
  <PageHero label="About the Team" title="Drain experience backed by evidence." intro="More than 25 years of plumbing experience, specialist drainage equipment and a clear distinction between temporary clearing and lasting repair." image="/images/team.webp" imageAlt="Three Antons plumbers standing beside a blue service vehicle" />
  <section class="section detail-grid">
    <div><h2>Who Operates the Service</h2><p>Antons Blocked Drains Hills District is operated by {site.operator}. Regulated drainage work is undertaken under NSW contractor licence {site.licence}.</p><p>The focused name makes it easier for Hills District customers to find specialist blocked-drain help while keeping the responsible legal operator clear.</p></div>
    <div><h2>How We Approach the Job</h2><p>We start with symptoms, inspect accessible pipework and choose equipment for the line. High-pressure jetting may clear the obstruction; CCTV and electronic locating can show why it returned; targeted excavation can repair a failed section.</p><p>Explore our <a href="/services/">blocked drain services</a> or <a href="/contact/">call the team</a> to discuss the next step.</p></div>
  </section>
  <section class="operator-gallery"><ResponsiveImage src="/images/drain-camera-inspection.webp" alt="CCTV drain inspection equipment used to diagnose pipe condition" sizes="(max-width: 760px) calc(100vw - 32px), 46vw" loading="lazy" /><ResponsiveImage src="/images/blocked-drain-excavation.webp" alt="Antons plumber completing underground drainage work" sizes="(max-width: 760px) calc(100vw - 32px), 46vw" loading="lazy" /></section>
  <FaqSection title="About Our Drain Service" intro="Answers about experience, licensing, equipment and what customers can expect." items={pageFaqs.about} />
  <CtaBand />
</BaseLayout>
