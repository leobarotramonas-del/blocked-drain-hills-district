---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import CtaBand from '../../components/CtaBand.astro';
import FaqSection from '../../components/FaqSection.astro';
import { areas } from '../../data/site';
import { faqSchema, pageFaqs } from '../../data/faqs';
---
<BaseLayout title="Blocked Drain Service Areas Hills District" description="Find blocked drain services across Baulkham Hills, Castle Hill, Kellyville, Rouse Hill and nearby Hills District suburbs. Check local drainage guidance." schema={faqSchema(pageFaqs.serviceAreas)}>
  <PageHero label="Service Areas" title="Local drainage knowledge, suburb by suburb." intro="Trees, slope, property age, access and shared services change how a blocked drain should be investigated. Choose your area for useful local context and booking guidance." image="/images/area-baulkham-hills.webp" imageAlt="Antons plumbing service vehicles prepared for Hills District calls" />
  <section class="section area-directory"><p><a href="/contact/">Contact us with the full address</a> to confirm coverage. For the available clearing and repair methods, explore our <a href="/services/">blocked drain services</a>.</p>{areas.map((area) => <article><p>NSW {area.postcode}</p><h2>{area.name}</h2><p>{area.localIssue}.</p><a class="text-link" href={`/service-areas/${area.slug}/`}>Blocked drains {area.name}</a></article>)}</section>
  <FaqSection title="Questions About Hills District Coverage" intro="How address checks, access, urgent calls and licensing work." items={pageFaqs.serviceAreas} />
  <CtaBand title="Check Your Hills District Address" />
</BaseLayout>
